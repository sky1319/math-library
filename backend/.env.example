# Copy variable names into your operating-system environment. Never commit real values.
JWT_SECRET=replace-with-at-least-32-random-bytes
DEEPSEEK_API_KEY=replace-with-a-new-rotated-api-key

# Optional first-admin bootstrap. Keep disabled after the initial setup.
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_USER=
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_ADMIN_NAME=Library Administrator
APP_DEMO_USERS_FILE=

# Optional overrides
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=120000
AGENT_MAX_ITERATIONS=6
AGENT_HISTORY_LIMIT=8

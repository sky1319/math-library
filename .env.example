# Copy to .env for local Docker Compose use. Never commit real secrets.
DB_PASSWORD=replace-with-a-strong-database-password
JWT_SECRET=replace-with-at-least-48-random-bytes
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
APP_DEMO_DATA_ENABLED=false
# Optional first-admin bootstrap. Enable only for a one-time controlled setup.
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_USER=
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_ADMIN_NAME=Library Administrator
APP_DEMO_USERS_FILE=
APP_CORS_ALLOWED_ORIGINS=http://localhost:8082
